AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=replace-with-project-key
OPENAI_MODEL=replace-with-available-structured-output-model
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=replace-with-sonarqube-user-token
# Optional PostgreSQL; otherwise H2 persists under ./data:
 SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/prgate_ai
 SPRING_DATASOURCE_USERNAME=prgate
 SPRING_DATASOURCE_PASSWORD=replace-with-database-password