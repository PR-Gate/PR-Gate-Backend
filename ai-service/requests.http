@baseUrl = http://localhost:8081
@serviceToken = replace-with-INTERNAL_SERVICE_TOKEN
@planId = replace-with-created-plan-id
@assessmentId = replace-with-created-assessment-id

### Generate a DRAFT plan with the real LLM
POST {{baseUrl}}/api/technical-plans
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "rubricId": "rubric-1",
  "rubricVersion": 1,
  "language": "java",
  "criteria": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "description": "Evitar variables locales que nunca se utilizan.",
      "objective": "Identificar codigo innecesario y mejorar la legibilidad."
    }
  ]
}

### Copy the created plan ID above
GET {{baseUrl}}/api/technical-plans/{{planId}}
Authorization: Bearer {{serviceToken}}

### Validate against the real SonarQube catalog
POST {{baseUrl}}/api/technical-plans/{{planId}}/approval
Authorization: Bearer {{serviceToken}}

### Record actual findings from the trusted analysis backend.
### Replace ruleKey with the corresponding SONAR_RULE target in the approved plan.
POST {{baseUrl}}/api/assessments
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "planId": "{{planId}}",
  "studentId": "student-1",
  "submissionId": "submission-1",
  "revision": "replace-with-actual-commit",
  "analysisId": "replace-with-actual-sonar-analysis",
  "findings": [
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "criterionId": "11111111-1111-4111-8111-111111111111",
      "ruleKey": "replace-with-rule-from-approved-plan",
      "filePath": "src/Main.java",
      "line": 5,
      "message": "replace-with-real-scanner-message"
    }
  ]
}

### Generate and persist feedback with the real LLM
POST {{baseUrl}}/api/assessments/{{assessmentId}}/feedback
Authorization: Bearer {{serviceToken}}

### Read persisted analysis and feedback
GET {{baseUrl}}/api/assessments/{{assessmentId}}
Authorization: Bearer {{serviceToken}}

### Retry only when feedback generation is FAILED
POST {{baseUrl}}/api/assessments/{{assessmentId}}/feedback/retry
Authorization: Bearer {{serviceToken}}