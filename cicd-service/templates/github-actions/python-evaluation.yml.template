name: PRGate Evaluation

on:
  push:
  pull_request:

jobs:
  evaluate:
    # Student code runs only on a dedicated, isolated runner.
    runs-on: [self-hosted, prgate-analysis]
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install project dependencies
        if: hashFiles('requirements.txt') != ''
        run: python -m pip install -r requirements.txt
      - name: Check Python syntax
        run: python -m compileall -q .
      - name: Run tests when present
        if: hashFiles('tests/test_*.py', 'tests/**/test_*.py') != ''
        run: |
          python -m pip install pytest
          python -m pytest -q
      - name: Analyze configured branch
        if: github.event_name == 'push' && github.ref_name == vars.PRGATE_ANALYSIS_BRANCH
        uses: SonarSource/sonarqube-scan-action@v7
        env:
          SONAR_TOKEN: ${{ secrets.PRGATE_SONAR_ANALYSIS_TOKEN }}
          SONAR_HOST_URL: ${{ vars.PRGATE_SONAR_URL }}
        with:
          args: >-
            -Dsonar.projectKey=${{ vars.PRGATE_SONAR_PROJECT_KEY }}
            -Dsonar.sources=.
            -Dsonar.exclusions=.venv/**,venv/**,__pycache__/**,.pytest_cache/**
            -Dsonar.scm.revision=${{ github.sha }}
            -Dsonar.analysis.prgateRepositoryId=${{ github.repository_id }}
            -Dsonar.analysis.prgateRunId=${{ github.run_id }}
            -Dsonar.analysis.prgateRunAttempt=${{ github.run_attempt }}
            -Dsonar.analysis.prgateBranch=${{ github.ref_name }}
