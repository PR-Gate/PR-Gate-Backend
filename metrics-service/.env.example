# Docker Compose reads this file only when passed with --env-file.
SERVER_PORT=8084
DB_PASSWORD=
RABBITMQ_USERNAME=prgate
RABBITMQ_PASSWORD=
# Read-only Sonar credentials for historical evidence.
SONAR_TOKEN=
DOCKER_SONAR_URL=http://host.docker.internal:9000
# Internal backend API only. Never expose these service credentials to the browser.
METRICS_API_TOKEN=
METRICS_PROJECTS_TOKEN=
DOCKER_PROJECTS_URL=http://host.docker.internal:8083
# Same private value as INTERNAL_SERVICE_TOKEN in AI.
AI_SERVICE_TOKEN=
DOCKER_AI_URL=http://host.docker.internal:8081
