# Local development credentials must match application-local.yml.
DB_USERNAME=prgate
DB_PASSWORD=prgate-local
DB_URL=jdbc:postgresql://localhost:5432/pr-gate
POSTGRES_PORT=5433
PROJECTS_PORT=8081
spring.profiles.active=local
# Local Swagger identities: UUID:ROLE:STATUS;UUID:ROLE:STATUS
prgate.local.users=
# For Cognito: SPRING_PROFILES_ACTIVE=cognito and fill both values.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
