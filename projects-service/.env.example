# Local development credentials must match application-local.yml.
DB_USERNAME=prgate_projects
DB_PASSWORD=prgate-local
DB_URL=jdbc:postgresql://localhost:5433/prgate_projects
POSTGRES_PORT=5433
PROJECTS_PORT=8083
SPRING_PROFILES_ACTIVE=local
# Local Swagger identities: UUID:ROLE:STATUS;UUID:ROLE:STATUS
PROJECTS_LOCAL_USERS=
# For Cognito: SPRING_PROFILES_ACTIVE=cognito and fill both values.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
# Internal permissions lookup for Metrics; same value as Metrics, never a browser token.
METRICS_PROJECTS_TOKEN=
PROJECTS_USERS_REMOTE_ENABLED=false
# Same private value as INTERNAL_SERVICE_TOKEN in Users.
USERS_SERVICE_TOKEN=
