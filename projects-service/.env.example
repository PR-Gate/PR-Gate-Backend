# Local development credentials must match application-local.yml.
DB_USERNAME=prgate_projects
DB_PASSWORD=prgate-local
DB_URL=jdbc:postgresql://localhost:5433/prgate_projects
POSTGRES_PORT=5433
PROJECTS_PORT=8083
SPRING_PROFILES_ACTIVE=local
# Local Swagger identities: UUID:ROLE:STATUS;UUID:ROLE:STATUS
PROJECTS_LOCAL_USERS=
