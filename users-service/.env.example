# Puerto HTTP del servicio
SERVER_PORT=8080

# PostgreSQL local (Docker Compose)
POSTGRES_PASSWORD=prgate_local
POSTGRES_PORT=5432

# Para ejecutar desde el IDE, exportar estas variables en el proceso Java
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/prgate_users
SPRING_DATASOURCE_USERNAME=prgate
SPRING_DATASOURCE_PASSWORD=prgate_local

# Token de servicio que Proyectos envía como Bearer en /internal/**
INTERNAL_SERVICE_TOKEN=cambia-este-token-en-cada-entorno
